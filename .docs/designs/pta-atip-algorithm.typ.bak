  O1{{"O1 spans"}} -.-> s1
  O2{{"O2 sameness<br/>(used again in 3)"}} -.-> s2
  O5{{"O5 delta?"}} -.-> s3
  O3{{"O3 · O4 · O6 · O7"}} -.-> s4
