{
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "linkedProjects": ["./Cargo.toml"],
        "cargo": { "features": "all", "targetDir": true },
        "check": {
          "command": "clippy",
          "features": "all",
          "workspace": false
        }
      }
    }
  },
  "format_on_save": "modifications_if_available",
  "file_scan_inclusions": ["lib", "bin", "misc"]
}
